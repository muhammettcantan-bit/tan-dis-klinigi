# TAN DİŞ KLİNİĞİ - Örnek Ortam Değişkenleri

# Sunucu Yapılandırması
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key

# MySQL Veritabanı Yapılandırması
DB_HOST=localhost
